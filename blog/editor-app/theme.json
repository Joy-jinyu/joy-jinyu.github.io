{
  "name": "Pairwise 投稿",
  "cssVars": {
    "theme": {
      "radius": "12px",
      "radius-card": "18px",
      "radius-sm": "8px"
    },
    "light": {
      "background": "#ffffff",
      "foreground": "#282c36",
      "strong": "#0a0e19",
      "muted-foreground": "#6c6e75",
      "faint": "#a9abae",
      "card": "#fafafa",
      "card-foreground": "var(--foreground)",
      "popover": "#ffffff",
      "popover-foreground": "var(--foreground)",
      "field": "#ffffff",
      "primary": "#0b7f7f",
      "primary-hover": "#0a7272",
      "primary-active": "#096565",
      "primary-foreground": "#ffffff",
      "primary-tint": "color-mix(in srgb, var(--primary) 10%, transparent)",
      "brand-2": "#0b8f8f",
      "secondary": "rgba(10,14,25,0.04)",
      "secondary-hover": "rgba(10,14,25,0.08)",
      "secondary-active": "rgba(10,14,25,0.12)",
      "secondary-foreground": "var(--strong)",
      "muted": "rgba(10,14,25,0.04)",
      "accent": "rgba(10,14,25,0.06)",
      "accent-foreground": "var(--strong)",
      "hover": "rgba(10,14,25,0.05)",
      "pressed": "rgba(10,14,25,0.09)",
      "border": "rgba(10,14,25,0.08)",
      "border-strong": "rgba(10,14,25,0.14)",
      "input": "var(--border-strong)",
      "ring": "color-mix(in srgb, var(--primary) 55%, transparent)",
      "ring-destructive": "color-mix(in srgb, var(--destructive) 55%, transparent)",
      "destructive": "#c2334a",
      "destructive-tint": "color-mix(in srgb, var(--destructive) 10%, transparent)",
      "warn": "#b26b00",
      "warn-tint": "color-mix(in srgb, var(--warn) 12%, transparent)",
      "scrim": "rgba(10,14,25,0.32)"
    },
    "dark": {
      "background": "#07090f",
      "foreground": "#c3c9d4",
      "strong": "#f3f5f9",
      "muted-foreground": "#7d8596",
      "faint": "#4a5160",
      "card": "#0f1117",
      "card-foreground": "var(--foreground)",
      "popover": "#16181d",
      "popover-foreground": "var(--foreground)",
      "field": "#0b0d13",
      "primary": "#00b8b8",
      "primary-hover": "#14c4c4",
      "primary-active": "#00a3a3",
      "primary-foreground": "#001414",
      "primary-tint": "color-mix(in srgb, var(--primary) 14%, transparent)",
      "brand-2": "#5eead4",
      "secondary": "rgba(255,255,255,0.06)",
      "secondary-hover": "rgba(255,255,255,0.11)",
      "secondary-active": "rgba(255,255,255,0.15)",
      "secondary-foreground": "var(--strong)",
      "muted": "rgba(255,255,255,0.05)",
      "accent": "rgba(255,255,255,0.07)",
      "accent-foreground": "var(--strong)",
      "hover": "rgba(255,255,255,0.05)",
      "pressed": "rgba(255,255,255,0.09)",
      "border": "rgba(255,255,255,0.08)",
      "border-strong": "rgba(255,255,255,0.14)",
      "input": "var(--border-strong)",
      "ring": "color-mix(in srgb, var(--primary) 60%, transparent)",
      "ring-destructive": "color-mix(in srgb, var(--destructive) 60%, transparent)",
      "destructive": "#ff7a85",
      "destructive-tint": "color-mix(in srgb, var(--destructive) 14%, transparent)",
      "warn": "#f5b454",
      "warn-tint": "color-mix(in srgb, var(--warn) 14%, transparent)",
      "scrim": "rgba(0,0,0,0.6)"
