{
  "about": "从 raw/ 里的截图（sidebar.swift 第三次运行，2x，1 pt = 2 px）读的像素；复算：../read-pixels.sh，输出 pixels-readings.txt。颜色是截图上的 sRGB 读数，受壁纸着色和 P3 转换影响，只作「看起来」的佐证；系统颜色值以 lab:macos/data/metrics.json 为准。",
  "env": {
    "os": "macOS 26.6.2 (25G83)",
    "accent": "系统默认（多色）",
    "sidebarIconSize": "系统默认（NSTableViewDefaultSizeMode 未设置）"
  },
  "sidebarGlass": {
    "shot": "raw/main-light-key.png",
    "leftEdgePt": 8,
    "topEdgePt": 8,
    "cornerEqRadiusPt": 18.8,
    "cmd": [
      "edge raw/main-light-key.png find 0 10 120 90 '#FFFFFF' 1",
      "pixels raw/main-light-key.png scan y 400 0 40",
      "pixels raw/main-light-key.png scan x 200 0 40"
    ],
    "note": "浅色玻璃边上有一圈 1 pt 的白色描边（#FFFFFF），按描边逐行找起点；深色截图 scan 也在 16 px（8 pt）处换色"
  },
  "selectionPill": {
    "shot": "raw/main-light-key.png",
    "rowSizeStyle": "medium",
    "xPt": 18,
    "wPt": 120,
    "topPt": 103,
    "hPt": 32,
    "insetFromGlassPt": 10,
    "cornerEqRadiusPt": 6.8,
    "cmd": [
      "edge raw/main-light-key.png 30 200 200 240 40",
      "pixels raw/main-light-key.png scan x 150 195 280",
      "pixels raw/main-light-key.png scan y 220 20 300"
    ]
  },
  "sidebarSelectionColors": {
    "cmd": "edge raw/<shot> at 250 212（选中块）；edge raw/<shot> at 103 238（选中行图标 / 文字）",
    "light": {
