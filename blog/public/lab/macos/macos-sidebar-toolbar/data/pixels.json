      "row1": "#FFFFFF",
      "row2": "#F4F5F5",
      "selectedFocused": "#0064E1",
      "selectedUnfocused": "#DBDCDC"
    },
    "dark": {
      "row1": "#242A2E",
      "row2": "#2E3439",
      "selectedFocused": "#0058D0",
