        "shot": "raw/main-light-key.png",
        "pill": "#007AFF",
        "fg": "#FFFFFF"
      },
      "focusElsewhere": {
        "shot": "raw/main-light-tablefocus.png",
        "pill": "#EFEFEF",
        "fg": "#007AFF"
      },
      "windowInactive": {
        "shot": "raw/main-light-inactive.png",
        "pill": "#F2F2F2",
        "fg": "#007AFF"
      }
    },
    "dark": {
      "keyFocused": {
        "shot": "raw/main-dark-key.png",
        "pill": "#008EFF",
        "fg": "#FFFFFF"
      },
      "focusElsewhere": {
        "shot": "raw/main-dark-tablefocus.png",
        "pill": "#2C3134",
        "fg": "#007AFF"
      },
      "windowInactive": {
        "shot": "raw/main-dark-inactive.png",
        "pill": "#2F3336",
        "fg": "#007AFF"
      }
    }
  },
  "sidebarIconUnselected": {
    "shots": [
      "raw/main-light-key.png",
      "raw/main-dark-key.png"
    ],
    "cmd": "pixels raw/<shot> scan y 174 100 150（Inbox 行的图标）",
    "light": "#000000",
    "dark": "#FFFFFF",
    "note": "默认 tint 配置、系统强调色为默认（多色）时，没选中的侧边栏图标是黑 / 白单色，不是强调色"
  },
  "tableColors": {
    "cmd": "edge raw/tables-<light|dark>-key.png at <x> <y>：fullWidth 300,165 / 300,212 / 300,260；inset 930,270",
