---
import Base from '../layouts/Base.astro'
import ColumnSheet from '../components/ColumnSheet.astro'
import { listPosts, listColumnGroups, formatDate } from '../lib/posts'
import { BLOG_ID, JOY, WEBSITE_ID } from '../lib/seo'

const posts = await listPosts()
const groups = await listColumnGroups()
const base = import.meta.env.BASE_URL

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': BLOG_ID,
  name: 'Pairwise 博客',
  url: new URL(base, Astro.site).href,
  inLanguage: 'zh-CN',
  author: JOY,
  publisher: JOY,
  isPartOf: { '@id': WEBSITE_ID },
  blogPost: posts.map((p) => {
    const url = new URL(`${base}${p.id}/`, Astro.site).href
    return { '@type': 'BlogPosting', '@id': `${url}#article`, headline: p.data.title, url, datePublished: p.data.date.toISOString() }
  }),
}
---

<Base
  title="Pairwise 博客 · Joy 的 AI 应用与前端工程实践"
  description="Pairwise 博客：Joy 写的 AI 应用开发、AI 写界面的审美与约束、前端工程化和终端工具实践。"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="eyebrow">Pairwise Blog · {posts.length} 篇 · {groups.length} 个专栏</div>
    <h1>写给未来的自己</h1>
    <p class="lede">Pairwise 的博客：日常在用的工具、踩过的坑和做过的取舍。笔记站放成体系的知识点，这里放完整的一篇；按专栏分组，专栏里按阅读顺序排。</p>
  </section>

  {posts.length === 0 && <p class="empty">还没有文章。</p>}

  {groups.length > 0 && (
    <section class="cols" aria-labelledby="cols-title">
      <div class="cols-head">
        <h2 id="cols-title">专栏</h2>
        <span class="hint">每个圆点是一篇</span>
      </div>
      <div class="bento">
        {groups.map((g, i) => {
          const n = g.posts.length
          const latest = g.posts.at(-1)!.data.date
          return (
            <div class:list={['cell', i === 0 && 'wide']} id={g.id} style={`--i:${i};--tint:${g.tint}`}>
              <button type="button" class="card" data-col={g.id} aria-haspopup="dialog" aria-labelledby={`${g.id}-name`} aria-describedby={`${g.id}-desc`}>
                <span class="card-top">
                  <span class="tile" aria-hidden="true">{g.glyph}</span>
                  <span class="date">更新于 <time datetime={latest.toISOString()}>{formatDate(latest)}</time></span>
                </span>
                <span class="name" id={`${g.id}-name`}>{g.title}</span>
                <span class="desc" id={`${g.id}-desc`}>{g.blurb}</span>
                <span class="card-foot">
                  <span class="count">
                    <span class="dots" aria-hidden="true">{g.posts.map((_, k) => <i style={`--k:${k}`} />)}</span>
                    <span>{n} 篇</span>
                  </span>
                  <span class="go" aria-hidden="true">
                    {n > 1 ? '打开专栏' : '阅读'}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                  </span>
                </span>
              </button>
            </div>
          )
        })}
      </div>
    </section>
  )}

  {groups.map((g) => <ColumnSheet group={g} />)}

  {/*
    首帧前恢复弹层：从文章页返回时，标题的跨页形变要落在弹层里那篇的预览上。
    地址里的 #专栏 id 决定开哪个专栏；sessionStorage 记着上次推入的是第几篇（见下方脚本的 VIEW_KEY），只在后退 / 刷新时恢复。
  */}
  <script is:inline>
    try {
      const id = decodeURIComponent(location.hash.slice(1))
      const sheet = id && document.getElementById(`sheet-${id}`)
      if (sheet) {
        const nav = performance.getEntriesByType('navigation')[0]
        const back = nav && (nav.type === 'back_forward' || nav.type === 'reload')
        const [col, n] = (sessionStorage.getItem('blog-sheet-view') || '').split(':')
        const view = back && col === id && sheet.querySelector(`.view[data-view="${Number(n)}"]`)
        if (view) {
          sheet.querySelectorAll('.view').forEach((v) => (v.hidden = v !== view))
        }
        sheet.showModal()
      }
    } catch {
      /* 存储不可用或浏览器不支持 dialog 时不恢复，不影响阅读 */
    }
  </script>
</Base>

<style>
  .hero, .cols, .empty { max-width: 1120px; margin: 0 auto; padding-inline: 24px; }
  .hero { padding-block: 88px 24px; }
  h1 {
    margin: 14px 0 0;
    font: 700 clamp(40px, 7vw, 64px) / 1.02 var(--sans);
    letter-spacing: -0.045em;
    background: linear-gradient(100deg, var(--hi-1) 30%, var(--hi-2) 62%, var(--brand) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede { max-width: 38em; margin: 18px 0 0; color: var(--muted); font-size: 17px; }

  .empty { color: var(--muted); }

  .cols { padding-top: 40px; }
  .cols-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .cols-head h2 { margin: 0; color: var(--strong); font: 700 22px/1.4 var(--sans); letter-spacing: -0.01em; }
  .hint { color: var(--muted); font: 400 12px/1 var(--mono); }

  .bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 20px; }
  .cell { display: flex; min-height: 280px; scroll-margin-top: calc(var(--header-h) + 24px); }
  .cell.wide { grid-column: span 2; min-height: 300px; }

  /* 卡片：widget 质感 + 指针光斑 + 轻微 3D 倾斜；--mx/--my/--rx/--ry 由下方脚本写入 */
  .card {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 26px;
    overflow: hidden;
    border: 1px solid var(--line-hi);
    border-radius: 24px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--strong) 6%, var(--bg)), color-mix(in srgb, var(--strong) 3%, var(--bg)));
    color: var(--text);
    font: inherit;
    text-align: left;
    box-shadow: 0 1px 0 rgba(var(--ink-rgb), 0.04) inset, 0 8px 24px -16px rgba(0, 0, 0, 0.5);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1), box-shadow 0.4s ease, border-color 0.3s ease;
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(0, 184, 184, 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .card > * { position: relative; }
  .card:hover, .card:focus-visible {
    border-color: color-mix(in srgb, var(--brand) 40%, transparent);
    box-shadow: 0 1px 0 rgba(var(--ink-rgb), 0.04) inset, 0 30px 60px -30px var(--brand-glow);
  }
  /* 跟手阶段用短的线性过渡，离开时再用上面的弹回曲线 */
  .card:hover { transition: transform 0.12s linear, box-shadow 0.4s ease, border-color 0.3s ease; }
  .card:hover::before, .card:focus-visible::before { opacity: 1; }
  .card:active { transform: perspective(900px) scale(0.975); transition: transform 0.15s ease; }
  .card:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 24px; }

  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .tile {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 22%;
    background: var(--tint);
    color: #fff;
    font: 700 16px/1 var(--sans);
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 6px 14px -6px rgba(0, 0, 0, 0.45);
    transition: transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.4);
  }
  .wide .tile { width: 56px; height: 56px; font-size: 20px; }
  .card:hover .tile { transform: rotate(-6deg) scale(1.06); }
  .date { color: var(--muted); font: 400 12px/1 var(--mono); }
  .name { margin-top: 8px; color: var(--strong); font: 700 24px/1.2 var(--sans); letter-spacing: -0.01em; }
  .wide .name { font-size: 34px; }
  .desc { flex: 1; max-width: 520px; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .card-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 8px; }
  .count { display: flex; align-items: center; gap: 12px; color: var(--muted); font: 400 12px/1 var(--mono); }
  .dots { display: flex; flex-wrap: wrap; gap: 6px; }
  .dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--tint); }
  .go { display: inline-flex; flex: none; align-items: center; gap: 6px; color: var(--strong); font: 600 13px/1 var(--sans); transition: gap 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.4); }
  .card:hover .go { gap: 10px; }

  @media (prefers-reduced-motion: no-preference) {
    .cell { animation: cols-rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(var(--i) * 90ms + 120ms); }
    .dots i { animation: cols-dot 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.5) both; animation-delay: calc(var(--i) * 90ms + 500ms + var(--k) * 50ms); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover, .tile, .go { transition: none; }
  }
  @keyframes cols-rise { from { opacity: 0; transform: translateY(22px) scale(0.97); } }
  @keyframes cols-dot { from { opacity: 0; transform: scale(0.2); } }

  @media (max-width: 900px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .cell, .cell.wide { grid-column: auto; min-height: 0; }
    .wide .name { font-size: 28px; }
  }
  @media (max-width: 640px) {
    .hero, .cols, .empty { padding-inline: 16px; }
    .hero { padding-block: 56px 16px; }
    .cols { padding-top: 32px; }
    .bento { gap: 16px; }
    .card { padding: 20px; }
  }
  /* 弹层打开时锁住页面滚动 */
  :global(html:has(dialog.sheet[open])) { overflow: hidden; }
</style>

<script>
  import { OPEN_COLUMN_EVENT } from '../lib/columns'

  /** 记下推入的是哪个专栏的第几篇，值形如「ui-taste:2」；从文章页返回时首帧前的内联脚本按它恢复 */
  const VIEW_KEY = 'blog-sheet-view'
  const reduced = matchMedia('(prefers-reduced-motion: reduce)')
  const sheets = [...document.querySelectorAll<HTMLDialogElement>('dialog.sheet')]
  const sheetOf = (id: string) => sheets.find((s) => s.dataset.col === id)

  function remember(value: string | null) {
    try {
      if (value) sessionStorage.setItem(VIEW_KEY, value)
      else sessionStorage.removeItem(VIEW_KEY)
    } catch {
      /* 存储不可用就不记，返回时停在专栏列表 */
    }
  }

  /** 弹层里切到列表页（'list'）或第 n 篇的预览页；dir 决定滑入方向，null 表示不做动画 */
  function show(sheet: HTMLDialogElement, view: 'list' | number, dir: 'push' | 'pop' | null) {
    let shown: HTMLElement | undefined
    for (const v of sheet.querySelectorAll<HTMLElement>('.view')) {
      const on = v.dataset.view === String(view)
      v.hidden = !on
      v.classList.remove('push', 'pop')
      if (on) shown = v
    }
    if (!shown) return
    if (dir && !reduced.matches) {
      void shown.offsetWidth
      shown.classList.add(dir)
    }
    sheet.querySelector('.scroll')!.scrollTop = 0
    remember(view === 'list' ? null : `${sheet.dataset.col}:${view}`)
  }

  function open(id: string) {
    const sheet = sheetOf(id)
    if (!sheet) return
    // 已经开着别的专栏（例如从搜索换到另一个专栏）时先关掉，同一时间只开一个
    for (const other of sheets) if (other !== sheet && other.open) other.close()
    show(sheet, 'list', null)
    if (!sheet.open) sheet.showModal()
    history.replaceState(history.state, '', `#${id}`)
  }

  for (const sheet of sheets) {
    const id = sheet.dataset.col!
    sheet.addEventListener('click', (e) => {
      // dialog 自身铺满视口，点到它而不是面板，就是点了遮罩
      if (e.target === sheet) return sheet.close()
      const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-act]')
      if (!btn) return
      const act = btn.dataset.act
      if (act === 'close') return sheet.close()
      if (act === 'list') {
        const from = sheet.querySelector<HTMLElement>('.post:not([hidden])')?.dataset.view
        show(sheet, 'list', 'pop')
        sheet.querySelector<HTMLElement>(`.row[data-n="${from}"]`)?.focus()
        return
      }
      if (act === 'post') {
        const n = Number(btn.dataset.n)
        const current = sheet.querySelector<HTMLElement>('.post:not([hidden])')?.dataset.view
        show(sheet, n, current !== undefined && n < Number(current) ? 'pop' : 'push')
        sheet.querySelector<HTMLElement>(`.post[data-view="${n}"] h3`)?.focus({ preventScroll: true })
      }
    })
    sheet.addEventListener('close', () => {
      remember(null)
      if (location.hash === `#${id}`) history.replaceState(history.state, '', location.pathname + location.search)
    })
  }

  document.querySelectorAll<HTMLButtonElement>('.card[data-col]').forEach((card) => {
    card.addEventListener('click', () => open(card.dataset.col!))
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect()
      const x = (e.clientX - r.left) / r.width
      const y = (e.clientY - r.top) / r.height
      card.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`)
      card.style.setProperty('--my', `${(y * 100).toFixed(1)}%`)
      if (reduced.matches) return
      card.style.setProperty('--ry', `${((x - 0.5) * 6).toFixed(2)}deg`)
      card.style.setProperty('--rx', `${((0.5 - y) * 6).toFixed(2)}deg`)
    })
    card.addEventListener('pointerleave', () => {
      card.style.setProperty('--rx', '0deg')
      card.style.setProperty('--ry', '0deg')
    })
  })

  // 首帧前的内联脚本恢复出来的弹层：浏览器随后滚到 #专栏 锚点时会把焦点移回 body，等加载完再挪进弹层
  const refocus = () => {
    const restored = sheets.find((s) => s.open)
    if (restored && !restored.contains(document.activeElement)) restored.querySelector<HTMLElement>('[data-act="close"]')!.focus()
  }
  if (document.readyState === 'complete') refocus()
  else window.addEventListener('load', () => setTimeout(refocus), { once: true })

  window.addEventListener(OPEN_COLUMN_EVENT, (e) => open((e as CustomEvent<string>).detail))
  window.addEventListener('hashchange', () => {
    try {
      open(decodeURIComponent(location.hash.slice(1)))
    } catch {
      /* 手改出来的坏地址（如 #%E0）解不开，忽略 */
    }
  })
</script>
