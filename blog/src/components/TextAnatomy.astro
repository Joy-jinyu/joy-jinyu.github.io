---
/**
 * 一行字的解剖：在读者自己的浏览器里实时量。蓝虚线是 CSS 给这行字的盒子，红线框是字形真正画到的地方；
 * 两者之间的色带是看不见的空白（裁剪以后变成冒出盒子的部分）。数字一律换算成 16 px 字号下的像素。
 * 字体栈和文章里三份 AI 页面一样：英文系统字体在前，苹方在后。
 */
import '../styles/spacing-lab.css'

const SAMPLES = [
  { key: 'cjk', label: '汉字', text: '邮件摘要' },
  { key: 'num', label: '数字', text: '8812 3390' },
  { key: 'lat', label: '英文', text: 'Settings' },
]
const MODES = [
  { key: 'none', label: '不裁' },
  { key: 'trim', label: '裁剪' },
  { key: 'pad', label: '裁剪后补回' },
]
---

<text-anatomy class="ta sx-panel not-prose">
  <div class="ta-ctrl">
    <div class="sx-seg" role="group" aria-label="文字">
      {SAMPLES.map((s, i) => <button type="button" data-sample={s.text} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>)}
    </div>
    <div class="sx-seg" role="group" aria-label="text-box 裁剪">
      {MODES.map((m, i) => <button type="button" data-trim={m.key} aria-pressed={i === 0 ? 'true' : 'false'}>{m.label}</button>)}
    </div>
    <label class="ta-lh">
      <span>行高</span>
      <input type="range" min="1" max="2" step="0.05" value="1.4" />
      <output>1.40</output>
    </label>
  </div>

  <div class="ta-stage">
    <div class="ta-wrap">
      <p class="ta-text">邮件摘要</p>
      <div class="ta-ov" aria-hidden="true">
        <i class="ta-band is-top"></i>
        <i class="ta-band is-bot"></i>
        <i class="ta-box"></i>
        <i class="ta-ink"></i>
        <span class="ta-tag is-top"></span>
        <span class="ta-tag is-bot"></span>
      </div>
    </div>
  </div>

  <p class="ta-read" aria-live="polite"></p>
  <p class="ta-note" hidden>你的浏览器还不支持 text-box，「裁剪」两项用不了；Chrome 133、Safari 18.2、Firefox 154 起支持。</p>
  <p class="sx-cap">
    在你的浏览器里实时量的，用的是你系统里的字体；数字换算成 16 px 字号。墨迹按字体度量推算，在 macOS 的 Chrome 上和逐像素扫描比，每边差不到 0.5 px。<span class="sx-w">蓝虚线</span>是 CSS 给这行字的盒子，
    <span class="sx-s">红框</span>是字形真正画到的地方，色带是两者之间的空白，裁剪以后是冒出盒子的部分。
  </p>
</text-anatomy>

<script>
  /** 文章里推荐的补偿值：macOS 上苹方的汉字在「英文字体在前」时，上面冒出 0.11–0.17em、下面 0.09–0.13em（12–24px 实测） */
  const PAD = '0.16em 0.12em'

  class TextAnatomy extends HTMLElement {
    private text!: HTMLParagraphElement
    private wrap!: HTMLElement
    private stage!: HTMLElement
    private ctx = document.createElement('canvas').getContext('2d')!
    private lh = 1.4
    private trim = 'none'

    connectedCallback() {
      this.text = this.querySelector('.ta-text')!
      this.wrap = this.querySelector('.ta-wrap')!
      this.stage = this.querySelector('.ta-stage')!
      const range = this.querySelector<HTMLInputElement>('input[type=range]')!
      const out = this.querySelector('output')!
      const supported = CSS.supports('text-box', 'trim-both cap alphabetic')
      if (!supported) {
        this.querySelector<HTMLElement>('.ta-note')!.hidden = false
        this.querySelectorAll<HTMLButtonElement>('[data-trim="trim"], [data-trim="pad"]').forEach((b) => (b.disabled = true))
      }
      range.addEventListener('input', () => {
        this.lh = Number(range.value)
        out.value = this.lh.toFixed(2)
        this.draw()
      })
      this.pick('[data-sample]', (b) => (this.text.textContent = b.dataset.sample!))
      this.pick('[data-trim]', (b) => (this.trim = b.dataset.trim!))
      new ResizeObserver(() => this.draw()).observe(this.stage)
    }

    /** 分段按钮：点了以后同组只亮一个，再重画 */
    private pick(sel: string, apply: (b: HTMLButtonElement) => void) {
      const group = [...this.querySelectorAll<HTMLButtonElement>(sel)]
      group.forEach((b) => b.addEventListener('click', () => {
        group.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
        apply(b)
        this.draw()
      }))
    }

    private draw() {
      const t = this.text
      const word = t.textContent ?? ''
      const fam = getComputedStyle(t).fontFamily
      // 放大倍数：让整行字连同右边的标注放得下
      this.ctx.font = `400 16px ${fam}`
      const w16 = this.ctx.measureText(word).width
      const scale = Math.max(2.2, Math.min(5, (this.stage.clientWidth - 150) / w16))
      t.style.fontSize = `${16 * scale}px`
      t.style.lineHeight = String(this.lh)
      t.style.setProperty('text-box', this.trim === 'none' ? 'normal' : 'trim-both cap alphabetic')
      t.style.paddingBlock = this.trim === 'pad' ? PAD : '0'

      const wr = this.wrap.getBoundingClientRect()
      const box = t.getBoundingClientRect()
      const rg = document.createRange()
      rg.selectNodeContents(t.firstChild!)
      const q = rg.getClientRects()[0]
      this.ctx.font = `400 ${16 * scale}px ${fam}`
      const m = this.ctx.measureText(word)
      // 内容区顶 + 字体的上伸高度 = 基线；基线上下各减去字形实际高度就是墨迹
      const baseline = q.top + m.fontBoundingBoxAscent
      const ink = { t: baseline - m.actualBoundingBoxAscent, b: baseline + m.actualBoundingBoxDescent }

      const set = (sel: string, top: number, h: number) => {
        const el = this.querySelector<HTMLElement>(sel)!
        el.style.top = `${top - wr.top}px`
        el.style.height = `${Math.max(0, h)}px`
      }
      set('.ta-box', box.top, box.height)
      set('.ta-ink', ink.t, ink.b - ink.t)
      const topGap = ink.t - box.top, botGap = box.bottom - ink.b
      set('.ta-band.is-top', Math.min(box.top, ink.t), Math.abs(topGap))
      set('.ta-band.is-bot', Math.min(box.bottom, ink.b), Math.abs(botGap))
      const px = (v: number) => (Math.round((v / scale) * 10) / 10).toFixed(1)
      const tag = (side: 'top' | 'bot', y: number, gap: number) => {
        const el = this.querySelector<HTMLElement>(`.ta-tag.is-${side}`)!
        el.style.top = `${y - wr.top}px`
        el.textContent = gap >= 0 ? `空白 ${px(gap)} px` : `冒出 ${px(-gap)} px`
        el.classList.toggle('is-over', gap < 0)
        this.querySelector<HTMLElement>(`.ta-band.is-${side}`)!.classList.toggle('is-over', gap < 0)
      }
      tag('top', (box.top + ink.t) / 2, topGap)
      tag('bot', (box.bottom + ink.b) / 2, botGap)

      const read = this.querySelector('.ta-read')!
      const inkH = px(ink.b - ink.t)
      read.textContent = this.trim === 'none'
        ? `16 px 的字，行高 ${this.lh.toFixed(2)}：盒子 ${px(box.height)} px，字形只有 ${inkH} px，剩下的分在上下。`
        : `裁剪以后行高不再起作用：盒子 ${px(box.height)} px，字形 ${inkH} px。`
    }
  }
  customElements.define('text-anatomy', TextAnatomy)
</script>

<style is:global>
  .ta-ctrl { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .ta-lh { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); font-size: 13px; }
  .ta-lh input { width: 140px; accent-color: var(--brand); }
  .ta-lh output { min-width: 3.2em; color: var(--strong); font: 500 13px/1 var(--mono); font-variant-numeric: tabular-nums; }
  .ta-stage { display: flex; justify-content: center; margin-top: 24px; padding: 36px 0; overflow: hidden; border-radius: 12px; background: var(--bg); box-shadow: inset 0 0 0 1px var(--line); }
  /* 右边留 150px 给标注：draw() 里按这个宽度算放大倍数 */
  .ta-wrap { position: relative; margin-right: 130px; }
  .ta-text {
    margin: 0;
    color: var(--strong);
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    font-weight: 400;
    white-space: nowrap;
  }
  .ta-ov { position: absolute; inset: 0; pointer-events: none; }
  .ta-box, .ta-ink, .ta-band { position: absolute; left: -6px; right: -6px; transition: top 0.25s var(--ease), height 0.25s var(--ease); }
  .ta-box { border: 1.5px dashed var(--sx-w); }
  .ta-ink { left: 0; right: 0; border: 1.5px solid var(--sx-s); }
  .ta-band { background: var(--sx-w-soft); }
  .ta-band.is-over { background: var(--sx-s-soft); }
  .ta-tag {
    position: absolute;
    left: calc(100% + 16px);
    transform: translateY(-50%);
    color: var(--sx-w);
    font: 600 13px/1 var(--mono);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    transition: top 0.25s var(--ease);
  }
  .ta-tag.is-over { color: var(--sx-s); }
  .ta-read { margin: 16px 0 0; color: var(--text); font-size: 14px; line-height: 1.6; font-variant-numeric: tabular-nums; }
  .ta-note { margin: 8px 0 0; color: var(--warn); font-size: 13px; }

  @media (max-width: 640px) {
    .ta-ctrl { flex-direction: column; align-items: stretch; }
    .ta-ctrl .sx-seg button { flex: 1; }
    .ta-lh input { flex: 1; width: auto; }
    .ta-wrap { margin-right: 110px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ta-box, .ta-ink, .ta-band, .ta-tag { transition: none; }
  }
</style>
