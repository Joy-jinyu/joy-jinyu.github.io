---
/** 顶栏的明暗切换：只在深色 / 浅色之间切；没手动选过时跟随系统 */
---

<button class="theme" type="button" aria-label="切换明暗主题" title="切换明暗主题">
  <span class="sun" aria-hidden="true">☀</span>
  <span class="moon" aria-hidden="true">☾</span>
</button>

<script>
  /** 与笔记站 ThemeSwitch 共用的 key：值为 light / dark，空表示跟随系统 */
  const KEY = 'starlight-theme'
  /**
   * 新主题从点击处以圆形扩散铺满全屏（View Transitions + clip-path），和简历页、笔记站同一套动效；
   * 不支持 View Transitions 或开了减少动效时直接切换
   */
  function reveal(apply: () => void, btn: HTMLElement, e: MouseEvent) {
    const root = document.documentElement
    if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return apply()
    const r = btn.getBoundingClientRect()
    const x = e.detail ? e.clientX : r.left + r.width / 2
    const y = e.detail ? e.clientY : r.top + r.height / 2
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
    root.classList.add('theme-reveal')
    const t = document.startViewTransition(apply)
    t.ready
      .then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 500, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', pseudoElement: '::view-transition-new(root)' },
        )
      })
      .catch(() => {})
    t.finished.finally(() => root.classList.remove('theme-reveal'))
  }

  document.querySelectorAll<HTMLButtonElement>('button.theme').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
      reveal(() => {
        document.documentElement.dataset.theme = next
        try {
          localStorage.setItem(KEY, next)
        } catch {
          // 隐私模式写不进去时只影响记忆，不影响本次切换
        }
      }, btn, e)
    })
  })
</script>

<style>
  /* 圆形扩散时关掉默认的交叉淡入，新画面由脚本用 clip-path 展开 */
  :global(.theme-reveal::view-transition-old(root)),
  :global(.theme-reveal::view-transition-new(root)) { animation: none; mix-blend-mode: normal; }
  .theme {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-left: 4px;
    border: 1px solid var(--line-hi);
    border-radius: 999px;
    background: rgba(var(--ink-rgb), 0.04);
    color: var(--strong);
    font-size: 15px;
    cursor: var(--cursor-pointer);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .theme:hover { border-color: var(--brand); box-shadow: 0 0 0 4px rgba(0, 184, 184, 0.08); }
  .theme span { grid-area: 1 / 1; transition: opacity 0.3s var(--ease), transform 0.4s var(--ease); }
  :global([data-theme="dark"]) .theme .sun,
  :global([data-theme="light"]) .theme .moon { opacity: 0; transform: rotate(-90deg) scale(0.6); }
</style>
