---
/**
 * 「这个键被谁接住」演示：终端 -> tmux -> nvim 三层，按键或点预设，看它停在哪一层、触发了什么。
 * 键位数据和状态机在 ../lib/key-route.ts
 */
import { PRESETS } from '../lib/key-route'
---

<key-route class="kr not-prose">
  <div class="kr-pad" tabindex="0" role="application" aria-label="按键路线演示。聚焦后按键，例如 Ctrl-a 再按反斜杠，或空格 f f；按 Tab 离开" aria-describedby="kr-result">
    <span class="kr-idle">点这里，然后按键：试试 <kbd>Ctrl-a</kbd> <kbd>\</kbd>、<kbd>Space</kbd> <kbd>f</kbd> <kbd>f</kbd>、<kbd>g</kbd> <kbd>d</kbd></span>
    <span class="kr-wait" hidden role="status">nvim 在等下一个键 <b class="kr-seq"></b><span class="kr-wait-note"></span><i class="kr-bar"></i></span>
  </div>
  <p class="kr-warn" hidden>Windows / Linux 的浏览器会拦下 <kbd>Ctrl-W</kbd>（关闭标签页），想看 <kbd>Ctrl-w</kbd> 系列请点下面的预设按钮。</p>

  <div class="kr-presets" role="group" aria-label="预设按键">
    {PRESETS.map((p, i) => <button type="button" data-preset={i}>{p.label}</button>)}
  </div>

  <ol class="kr-flow" aria-hidden="true">
    <li data-node="term"><b>终端</b><span>iTerm2 把按键发出去</span></li>
    <li class="kr-arrow"></li>
    <li data-node="tmux"><b>tmux</b><span>前缀和前缀后的键在这里截住</span></li>
    <li class="kr-arrow"></li>
    <li data-node="nvim"><b>nvim</b><span>其余按键都到这里</span></li>
  </ol>

  <div class="kr-result" id="kr-result" aria-live="polite">
    <div class="kr-keys">还没有按键</div>
    <div class="kr-action">按一个键，看它在哪一层被处理</div>
    <div class="kr-note"></div>
  </div>

  <ol class="kr-history" aria-label="最近的按键"></ol>
</key-route>

<script>
  import { KeyRoute } from '../lib/key-route-el'
  if (!customElements.get('key-route')) customElements.define('key-route', KeyRoute)
</script>

<style is:global>
  .kr { display: block; margin-top: 1.8em; padding: 18px; border: 1px solid var(--line-hi); border-radius: 16px; background: linear-gradient(180deg, var(--panel-hi), var(--panel)); }
  .kr-pad { display: flex; align-items: center; min-height: 52px; padding: 10px 16px; border: 1px dashed var(--line-hi); border-radius: 12px; color: var(--muted); font-size: 14px; cursor: text; transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  .kr-pad:focus { outline: none; border-style: solid; border-color: var(--brand); box-shadow: 0 0 0 4px rgba(0, 184, 184, 0.14); }
  .kr-wait { display: flex; align-items: center; gap: 10px; width: 100%; color: var(--strong); }
  .kr-wait[hidden] { display: none; }
  .kr-seq { font: 600 14px var(--mono); color: var(--brand-ink); }
  .kr-wait-note { color: var(--muted); font-size: 12.5px; }
  .kr-bar[hidden] { display: none; }
  .kr-warn { margin: 8px 0 0; color: var(--warn); font-size: 13px; }
  .kr-warn[hidden] { display: none; }
  .kr-bar { flex: 1; height: 3px; border-radius: 2px; background: linear-gradient(90deg, var(--brand), var(--brand-2)); transform-origin: left; animation: kr-count 0.3s linear forwards; }
  @keyframes kr-count { from { transform: scaleX(1); } to { transform: scaleX(0); } }

  .kr-flow { display: grid; grid-template-columns: 1fr 28px 1fr 28px 1fr; align-items: stretch; margin: 16px 0 0; padding: 0; list-style: none; }
  .kr-flow li { margin: 0; }
  .kr-flow [data-node] { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); transition: border-color 0.25s var(--ease), background 0.25s var(--ease), opacity 0.25s var(--ease), transform 0.25s var(--ease); }
  .kr-flow b { color: var(--strong); font: 600 14px/1.2 var(--mono); }
  .kr-flow span { color: var(--muted); font-size: 12.5px; line-height: 1.45; }
  .kr-arrow { position: relative; }
  .kr-arrow::before { content: ""; position: absolute; left: 4px; right: 4px; top: 50%; height: 1px; background: var(--line-hi); }
  .kr-arrow::after { content: ""; position: absolute; right: 3px; top: calc(50% - 4px); border: 4px solid transparent; border-left-color: var(--line-hi); border-right: 0; }
  /* 路线动画：pass = 经过，stop = 在这一层被处理，skip = 没到这一层 */
  .kr-flow [data-node].pass { border-color: rgba(0, 184, 184, 0.45); }
  .kr-flow [data-node].stop { border-color: var(--brand); background: rgba(0, 184, 184, 0.12); transform: translateY(-2px); box-shadow: 0 12px 30px -18px var(--brand-glow); }
  .kr-flow [data-node].stop b::after { content: " ← 在这里处理"; color: var(--brand-ink); font-weight: 500; font-size: 12px; }
  .kr-flow [data-node].skip { opacity: 0.4; }

  .kr-result { margin-top: 14px; padding: 12px 16px; border-left: 2px solid var(--brand); background: rgba(0, 184, 184, 0.05); border-radius: 0 10px 10px 0; }
  .kr-keys { color: var(--muted); font: 500 12px/1.5 var(--mono); }
  .kr-action { margin-top: 2px; color: var(--strong); font-weight: 600; }
  .kr-note { margin-top: 2px; color: var(--muted); font-size: 13.5px; }
  .kr-note:empty { display: none; }

  .kr-presets { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .kr-presets button { min-height: 34px; padding: 4px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--text); font: 500 12.5px/1.3 var(--mono); cursor: var(--cursor-pointer); -webkit-tap-highlight-color: transparent; transition: border-color 0.18s var(--ease), background 0.18s var(--ease); }
  @media (hover: hover) { .kr-presets button:hover { border-color: rgba(0, 184, 184, 0.5); background: rgba(0, 184, 184, 0.06); } }
  .kr-presets button:active { border-color: var(--brand); }
  .kr-history { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; padding: 0; list-style: none; }
  .kr-history li { margin: 0; padding: 2px 8px; border-radius: 6px; background: rgba(var(--ink-rgb), 0.04); color: var(--muted); font: 400 11.5px/1.6 var(--mono); }
  .kr-history li b { color: var(--brand-ink); font-weight: 500; }

  @media (max-width: 640px) {
    .kr { padding: 14px; }
    .kr-flow { grid-template-columns: 1fr; grid-auto-rows: auto; gap: 0; }
    .kr-arrow { height: 18px; }
    .kr-arrow::before { left: 50%; right: auto; top: 3px; bottom: 3px; width: 1px; height: auto; }
    .kr-arrow::after { right: auto; left: calc(50% - 4px); top: auto; bottom: 2px; border: 4px solid transparent; border-top-color: var(--line-hi); border-bottom: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kr-flow [data-node], .kr-presets button { transition: none; }
    .kr-flow [data-node].stop { transform: none; }
    .kr-bar { animation: none; }
  }
</style>
