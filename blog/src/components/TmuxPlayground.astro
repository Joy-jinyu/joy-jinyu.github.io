---
/**
 * 可交互的 tmux 模拟器：纯前端，不连真实终端。键位按文章里「我的配置」：前缀 Ctrl-a（也接受默认的 Ctrl-b）。
 * 键盘只在模拟器获得焦点时接管，Tab 照常移出；触屏用下方按钮区。脚本见 ../lib/tmux-sim.ts
 */
const pad = [
  { key: '\\', label: '左右分屏' },
  { key: '-', label: '上下分屏' },
  { key: 'h', label: '左' },
  { key: 'j', label: '下' },
  { key: 'k', label: '上' },
  { key: 'l', label: '右' },
  { key: 'z', label: '放大' },
  { key: 'x', label: '关闭 pane' },
  { key: 'c', label: '新窗口' },
  { key: 'n', label: '下一个' },
  { key: 'd', label: '离开' },
  { key: '?', label: '帮助' },
]
const tasks = [
  { id: 'split-h', text: '左右分屏' },
  { id: 'split-v', text: '再上下分屏' },
  { id: 'select', text: '在 pane 之间移动' },
  { id: 'unzoom', text: '放大一个 pane，再还原' },
  { id: 'back', text: '新建窗口，再切回 1 号窗口' },
  { id: 'attach', text: '离开会话，再回来' },
]
---

<tmux-playground class="tp not-prose">
  <div class="tp-term" tabindex="0" role="application" aria-label="tmux 模拟器。聚焦后先按 Ctrl-a，松开，再按操作键" aria-describedby="tp-how">
    <div class="tp-bar">
      <span class="tp-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="tp-title">tmux — demo</span>
      <span class="tp-prefix-chip">前缀 <kbd>Ctrl-a</kbd></span>
    </div>
    <div class="tp-screen"></div>
    <div class="tp-status"></div>
    <div class="tp-hint" aria-hidden="true"><span class="tp-hint-kb">点一下这里，然后按 <kbd>Ctrl-a</kbd> 松开，再按 <kbd>\</kbd></span><span class="tp-hint-touch">点下方按钮操作，或接上键盘直接按</span></div>
  </div>
  <p id="tp-how" class="sr-only">先按 Ctrl-a 进入前缀状态，再按反斜杠左右分屏、减号上下分屏、h j k l 移动、z 放大、c 新建窗口、d 离开、问号查看全部按键。按 Tab 离开模拟器。</p>
  <div class="tp-log" aria-live="polite"><span class="tp-log-k">tmux</span><code>按下前缀键后，这里显示等价的 tmux 命令</code></div>

  <div class="tp-below">
    <div class="tp-pad" role="group" aria-label="按键面板">
      {
        pad.map((p) => (
          <button type="button" data-key={p.key} title={`前缀 ${p.key}`}>
            <kbd>{p.key}</kbd>
            <span>{p.label}</span>
          </button>
        ))
      }
    </div>
    <div class="tp-tasks">
      <div class="tp-tasks-head">
        <span>跟着做 <b class="tp-count" aria-live="polite">0 / {tasks.length}</b></span>
        <button type="button" class="tp-reset">重置</button>
      </div>
      <ol>
        {
          tasks.map((t) => (
            <li data-task={t.id}>
              <span class="tp-check" aria-hidden="true" />
              {t.text}
              <span class="sr-only tp-state">（未完成）</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</tmux-playground>

<script>
  import { TmuxPlayground } from '../lib/tmux-sim'
  if (!customElements.get('tmux-playground')) customElements.define('tmux-playground', TmuxPlayground)
</script>

<style is:global>
  .tp { display: block; margin: 1.8em 0 0; }
  .tp-term {
    --t-bg: color-mix(in srgb, var(--bg) 90%, #0a3a3a 10%);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 360px;
    border: 1px solid var(--line-hi);
    border-radius: 14px;
    background: var(--t-bg);
    font: 400 13px/1.55 var(--mono);
    color: var(--text);
    overflow: hidden;
    box-shadow: 0 30px 70px -40px rgba(0, 0, 0, 0.7);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  :root[data-theme="light"] .tp-term { --t-bg: #0d1218; color: #c3c9d4; }
  .tp-term:focus-visible { outline: none; }
  .tp-term:focus, .tp-term:focus-within { border-color: var(--brand); box-shadow: 0 0 0 4px rgba(0, 184, 184, 0.14), 0 30px 70px -40px rgba(0, 0, 0, 0.7); }
  .tp-bar { display: flex; align-items: center; gap: 12px; height: 34px; padding: 0 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.07); color: #7d8596; font-size: 12px; }
  .tp-dots { display: flex; gap: 6px; }
  .tp-dots i { width: 10px; height: 10px; border-radius: 50%; background: #2a313c; }
  .tp-title { flex: 1; text-align: center; }
  .tp-prefix-chip kbd { font-size: 11px; color: #f3f5f9; border-color: rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.05); }
  .tp-screen { position: relative; flex: 1; min-height: 0; padding: 4px; }
  .tp-split { display: flex; width: 100%; height: 100%; gap: 1px; background: rgba(255, 255, 255, 0.12); }
  .tp-split.col { flex-direction: column; }
  .tp-split > * { min-width: 0; min-height: 0; transition: flex-grow 0.25s var(--ease); }
  .tp-pane { position: relative; display: flex; flex-direction: column; justify-content: flex-start; height: 100%; padding: 6px 10px; background: var(--t-bg); overflow: hidden; }
  .tp-pane::after { content: ""; position: absolute; inset: 0; border: 1px solid transparent; pointer-events: none; transition: border-color 0.2s var(--ease); }
  .tp-pane.on::after { border-color: rgba(0, 184, 184, 0.7); }
  .tp-pane .no { position: absolute; top: 4px; right: 8px; color: #4a5160; font-size: 11px; }
  .tp-pane.on .no { color: #5eead4; }
  .tp-line { white-space: pre-wrap; word-break: break-all; }
  .tp-line.out { color: #7d8596; }
  .tp-ps { color: #5eead4; }
  .tp-cur { display: inline-block; width: 7px; height: 1.1em; margin-left: 1px; vertical-align: -0.2em; background: transparent; }
  .tp-pane.on .tp-cur { background: #5eead4; }
  .tp-term:focus .tp-pane.on .tp-cur { animation: tp-blink 1.1s steps(1) infinite; }
  @keyframes tp-blink { 50% { opacity: 0; } }
  .tp-bignum { position: absolute; inset: 0; display: grid; place-items: center; color: #5eead4; font: 600 44px/1 var(--mono); background: rgba(0, 0, 0, 0.35); animation: tp-fade 0.2s var(--ease); }
  .tp-pane:not(.on) .tp-bignum { color: #f5b454; }
  @keyframes tp-fade { from { opacity: 0; } }
  .tp-status { display: flex; align-items: center; gap: 10px; height: 24px; padding: 0 8px; background: #121a22; color: #c3c9d4; font-size: 12px; white-space: nowrap; overflow: hidden; }
  .tp-status .s { color: #4ade80; }
  .tp-status .w.cur { color: #5eead4; font-weight: 600; }
  .tp-status .r { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .tp-status .clock-d { color: #22d3ee; }
  .tp-status .pfx { padding: 0 6px; border-radius: 4px; background: #00b8b8; color: #021616; font-weight: 600; }
  .tp-status .msg { padding: 0 6px; background: #f5b454; color: #1a1200; }
  .tp-status input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: #f3f5f9; font: inherit; }
  .tp-full { position: absolute; inset: 0; padding: 14px 16px; background: var(--t-bg); }
  .tp-full .tp-act { margin-top: 14px; }
  .tp-full button, .tp-help button { padding: 4px 12px; border: 1px solid rgba(0, 184, 184, 0.6); border-radius: 999px; background: transparent; color: #5eead4; font: inherit; cursor: pointer; }
  .tp-help { position: absolute; inset: 8px; padding: 12px 16px; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; background: #0b1016; overflow: auto; }
  .tp-help table { border-collapse: collapse; width: 100%; font-size: 12px; }
  .tp-help td { padding: 3px 10px 3px 0; vertical-align: top; }
  .tp-help td:first-child { color: #5eead4; white-space: nowrap; }
  .tp-hint { position: absolute; left: 50%; bottom: 40px; padding: 8px 14px; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 999px; background: rgba(7, 9, 15, 0.82); color: #c3c9d4; font: 500 12px/1.4 var(--sans); white-space: nowrap; transform: translateX(-50%); pointer-events: none; transition: opacity 0.25s var(--ease), transform 0.25s var(--ease); }
  .tp-hint kbd { color: #f3f5f9; border-color: rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.05); }
  .tp-term:focus .tp-hint, .tp-term.used .tp-hint { opacity: 0; transform: translate(-50%, 6px); }
  .tp-hint-touch { display: none; }
  @media (hover: none) { .tp-hint-kb { display: none; } .tp-hint-touch { display: inline; } }

  .tp-log { display: flex; align-items: center; gap: 10px; margin-top: 10px; padding: 8px 14px; border: 1px dashed var(--line-hi); border-radius: 10px; color: var(--muted); font: 400 12.5px/1.5 var(--mono); overflow-x: auto; white-space: nowrap; }
  .tp-log-k { color: var(--brand-ink); }
  .tp-log code { color: var(--strong); background: none !important; padding: 0 !important; }
  .tp-log.flash code { animation: tp-flash 0.6s var(--ease); }
  @keyframes tp-flash { from { color: var(--brand-2); } }

  .tp-below { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 14px; margin-top: 14px; }
  .tp-pad { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; align-content: start; }
  .tp-pad button { -webkit-tap-highlight-color: transparent; touch-action: manipulation; display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); color: var(--text); font: 500 13px/1.3 var(--sans); text-align: left; cursor: pointer; transition: border-color 0.18s var(--ease), background 0.18s var(--ease), transform 0.12s var(--ease); }
  /* 触屏点完会残留 :hover，只在真有悬停能力的设备上加悬停样式 */
  @media (hover: hover) { .tp-pad button:hover { border-color: rgba(0, 184, 184, 0.5); background: rgba(0, 184, 184, 0.06); } }
  .tp-pad button:active, .tp-pad button.hit { transform: scale(0.97); border-color: var(--brand); background: rgba(0, 184, 184, 0.12); }
  .tp-pad kbd { min-width: 26px; }
  .tp-tasks { padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); font-size: 13.5px; }
  .tp-tasks-head { display: flex; align-items: center; justify-content: space-between; color: var(--strong); font-weight: 600; }
  .tp-count { margin-left: 6px; color: var(--brand-2); font: 500 12px var(--mono); }
  .tp-reset { padding: 3px 10px; border: 1px solid var(--line-hi); border-radius: 999px; background: transparent; color: var(--muted); font: 500 12px/1.4 var(--mono); cursor: pointer; }
  .tp-reset:hover { color: var(--strong); border-color: var(--brand); }
  .tp-tasks ol { list-style: none; margin: 10px 0 0; padding: 0; }
  .tp-tasks li { display: flex; align-items: center; gap: 8px; margin: 0; padding: 4px 0; color: var(--muted); transition: color 0.2s var(--ease); }
  .tp-check { flex: none; width: 16px; height: 16px; border: 1.5px solid var(--line-hi); border-radius: 50%; transition: background 0.25s var(--ease), border-color 0.25s var(--ease); }
  .tp-tasks li.done { color: var(--strong); }
  .tp-tasks li.done .tp-check { border-color: var(--brand); background: radial-gradient(circle, var(--brand-2) 0 4px, transparent 4.5px); }
  .tp-tasks.all { border-color: rgba(0, 184, 184, 0.5); }

  @media (max-width: 720px) {
    .tp-term { height: 300px; }
    .tp-below { grid-template-columns: 1fr; }
    .tp-pad { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tp-prefix-chip { display: none; }
    .tp-hint { white-space: normal; width: max-content; max-width: calc(100% - 32px); text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tp-split > *, .tp-pad button, .tp-hint { transition: none; }
    .tp-term:focus .tp-pane.on .tp-cur, .tp-bignum, .tp-log.flash code { animation: none; }
  }
</style>
