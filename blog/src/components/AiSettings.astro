---
/**
 * 顶栏的「AI 设置」：访客填自己的 OpenAI 兼容接口（地址、模型、key），投稿编辑器等站内 AI 功能都用它。
 * 存取规则见 lib/ai-settings.ts；对话框是原生 <dialog>，焦点圈定和 Esc 关闭由浏览器负责。
 * 带 #ai-settings 打开页面时自动弹出（简历页的小猫跳过来用）。
 */
---

<ai-settings>
  <button class="ai-btn" type="button" aria-haspopup="dialog" aria-label="AI 设置" title="AI 设置">
    <span aria-hidden="true">AI</span>
    <i class="dot" aria-hidden="true"></i>
  </button>
  <dialog class="ai-dialog" aria-labelledby="ai-title">
    <form method="dialog" novalidate>
      <header>
        <h2 id="ai-title">AI 设置</h2>
        <p>填你自己的 OpenAI 兼容接口。key 只存在你的浏览器里，请求从浏览器直接发给服务商，不经过本站。</p>
      </header>
      <label class="field">
        <span>接口地址</span>
        <input name="baseUrl" type="url" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://api.openai.com/v1" required />
      </label>
      <label class="field">
        <span>API key</span>
        <span class="key">
          <input name="key" type="password" autocomplete="off" spellcheck="false" placeholder="sk-…" required />
          <button class="reveal" type="button" aria-pressed="false">显示</button>
        </span>
      </label>
      <div class="field">
        <label for="ai-model-select">模型</label>
        <div class="model-row">
          <select id="ai-model-select" name="modelSelect" disabled>
            <option value="">填好地址和 key 后获取</option>
          </select>
          <input name="model" autocomplete="off" spellcheck="false" placeholder="手动填模型名，例如 gpt-4o-mini" hidden aria-label="模型名" />
          <button class="ghost refresh" type="button" aria-label="重新获取模型列表" title="重新获取模型列表">获取</button>
        </div>
        <p class="hint" aria-live="polite"></p>
      </div>
      <label class="remember">
        <input name="remember" type="checkbox" />
        <span>在这台设备上记住<small>不勾时只在当前标签页有效，关掉就清除</small></span>
      </label>
      <p class="error" role="alert" hidden></p>
      <p class="test-result" aria-live="polite" hidden></p>
      <footer>
        <button class="ghost clear" type="button">清除</button>
        <button class="ghost test" type="button">测试</button>
        <span class="spacer"></span>
        <button class="ghost" type="button" value="cancel" formnovalidate>取消</button>
        <button class="primary" type="submit" value="save">保存</button>
      </footer>
    </form>
  </dialog>
</ai-settings>

<script>
  import { checkBaseUrl, clearAi, loadAi, onAiChange, onAiSettingsOpen, saveAi } from '../lib/ai-settings'
  import { listModels, ping } from '../lib/editor-host/ai'

  class AiSettingsElement extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector<HTMLButtonElement>('.ai-btn')!
      const dialog = this.querySelector<HTMLDialogElement>('dialog')!
      const form = dialog.querySelector('form')!
      const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement
      const select = form.querySelector<HTMLSelectElement>('select')!
      const manual = field('model')
      const hint = form.querySelector<HTMLElement>('.hint')!
      const error = form.querySelector<HTMLElement>('.error')!
      const result = form.querySelector<HTMLElement>('.test-result')!
      const reveal = form.querySelector<HTMLButtonElement>('.reveal')!
      const refreshBtn = form.querySelector<HTMLButtonElement>('.refresh')!
      const testBtn = form.querySelector<HTMLButtonElement>('.test')!
      /** 拉列表和测试各用一张票，晚到的结果作废；两者互不作废 */
      let listTicket = 0
      let testTicket = 0

      const paint = () => btn.classList.toggle('on', !!loadAi().config)
      const show = (msg = '') => {
        error.textContent = msg
        error.hidden = !msg
      }
      const showResult = (msg = '', ok = true) => {
        result.textContent = msg
        result.hidden = !msg
        result.classList.toggle('bad', !ok)
      }
      const model = () => (manual.hidden ? select.value : manual.value).trim()
      /** 列表拿不到时退回手动填 */
      const useManual = (on: boolean, value = '') => {
        manual.hidden = !on
        select.hidden = on
        if (on) manual.value = value || manual.value
      }
      const fillModels = (ids: string[], keep: string) => {
        select.replaceChildren(...ids.map((id) => new Option(id, id, false, id === keep)))
        select.disabled = false
        if (keep && !ids.includes(keep)) select.prepend(new Option(`${keep}（不在列表里）`, keep, true, true))
      }

      async function fetchModels(keep: string) {
        const baseUrl = field('baseUrl').value.trim()
        const key = field('key').value.trim()
        if (checkBaseUrl(baseUrl) || !key) {
          hint.textContent = '先填接口地址和 key'
          return
        }
        const mine = ++listTicket
        refreshBtn.disabled = true
        hint.textContent = '正在获取模型列表…'
        try {
          const ids = await listModels(baseUrl, key)
          if (mine !== listTicket) return
          if (!ids.length) throw new Error('这个接口没有返回模型，可以手动填模型名')
          useManual(false)
          fillModels(ids, keep)
          hint.textContent = `共 ${ids.length} 个模型`
        } catch (err) {
          if (mine !== listTicket) return
          useManual(true, keep)
          hint.textContent = (err as Error).message
        } finally {
          if (mine === listTicket) refreshBtn.disabled = false
        }
      }

      const openDialog = () => {
        const { config, remembered } = loadAi()
        field('baseUrl').value = config?.baseUrl ?? 'https://api.openai.com/v1'
        field('key').value = config?.key ?? ''
        field('remember').checked = remembered
        field('key').type = 'password'
        reveal.textContent = '显示'
        reveal.setAttribute('aria-pressed', 'false')
        select.replaceChildren(new Option(config?.model ?? '填好地址和 key 后获取', config?.model ?? ''))
        select.disabled = !config
        useManual(false)
        hint.textContent = ''
        show()
        showResult()
        dialog.showModal()
        if (config) void fetchModels(config.model)
      }

      paint()
      onAiChange(paint)
      onAiSettingsOpen(openDialog)
      btn.addEventListener('click', openDialog)
      // 去掉 hash 再打开：刷新页面不会再弹一次
      if (location.hash === '#ai-settings') {
        history.replaceState(history.state, '', location.pathname + location.search)
        openDialog()
      }
      reveal.addEventListener('click', () => {
        const on = field('key').type === 'password'
        field('key').type = on ? 'text' : 'password'
        reveal.textContent = on ? '隐藏' : '显示'
        reveal.setAttribute('aria-pressed', String(on))
      })
      // 地址或 key 改完就自动拉一次列表
      for (const name of ['baseUrl', 'key']) field(name).addEventListener('change', () => void fetchModels(model()))
      refreshBtn.addEventListener('click', () => void fetchModels(model()))
      testBtn.addEventListener('click', async () => {
        const baseUrl = field('baseUrl').value.trim()
        const key = field('key').value.trim()
        const msg = checkBaseUrl(baseUrl) ?? (!key ? 'API key 要填' : !model() ? '先选一个模型' : '')
        if (msg) return showResult(msg, false)
        const mine = ++testTicket
        testBtn.disabled = true
        showResult(`正在用 ${model()} 测试…`)
        try {
          const { ms } = await ping({ baseUrl, key, model: model() })
          if (mine === testTicket) showResult(`✓ 可以用，${model()} 回复用了 ${(ms / 1000).toFixed(1)} 秒`)
        } catch (err) {
          if (mine === testTicket) showResult(`✗ ${(err as Error).message}`, false)
        } finally {
          testBtn.disabled = false
        }
      })
      form.querySelector('[value=cancel]')!.addEventListener('click', () => dialog.close())
      form.querySelector('.clear')!.addEventListener('click', () => {
        clearAi()
        dialog.close()
      })
      // 点遮罩关闭：点击落在 dialog 自身（而不是表单内容）上就是点在遮罩上
      dialog.addEventListener('click', (e) => e.target === dialog && dialog.close())
      dialog.addEventListener('close', () => {
        listTicket++
        testTicket++
        refreshBtn.disabled = false
        testBtn.disabled = false
      })
      form.addEventListener('submit', (e) => {
        const baseUrl = field('baseUrl').value.trim()
        const key = field('key').value.trim()
        const msg = checkBaseUrl(baseUrl) ?? (!key ? 'API key 要填' : !model() ? '先选一个模型' : '')
        if (msg) {
          e.preventDefault()
          show(msg)
          return
        }
        saveAi({ baseUrl, model: model(), key }, field('remember').checked)
      })
    }
  }
  customElements.define('ai-settings', AiSettingsElement)
</script>

<style>
  ai-settings { display: contents; }
  .ai-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-left: 4px;
    border: 1px solid var(--line-hi);
    border-radius: 999px;
    background: rgba(var(--ink-rgb), 0.04);
    color: var(--strong);
    font: 600 11px/1 var(--mono);
    letter-spacing: 0.02em;
    cursor: var(--cursor-pointer);
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease), transform 0.18s var(--ease);
  }
  .ai-btn:hover { border-color: color-mix(in srgb, var(--brand) 55%, transparent); }
  .ai-btn:active { transform: scale(0.95); }
  .ai-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .dot {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--bg);
    border-radius: 50%;
    background: var(--brand);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.24s var(--ease), transform 0.24s var(--ease);
  }
  .ai-btn.on .dot { opacity: 1; transform: none; }

  .ai-dialog {
    width: min(440px, calc(100vw - 32px));
    padding: 0;
    border: 1px solid var(--line-hi);
    border-radius: 18px;
    background: var(--solid);
    color: var(--text);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
  }
  .ai-dialog::backdrop { background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(2px); }
  @media (prefers-reduced-motion: no-preference) {
    .ai-dialog[open] { animation: rise 0.36s var(--ease); }
    .ai-dialog[open]::backdrop { animation: fade 0.24s var(--ease); }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(10px) scale(0.98); } }
  @keyframes fade { from { opacity: 0; } }
  form { display: grid; gap: 14px; padding: 22px; }
  header h2 { margin: 0; color: var(--strong); font: 650 18px/1.3 var(--sans); }
  header p { margin: 6px 0 0; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .field { display: grid; gap: 6px; }
  .field > span:first-child, .field > label { color: var(--strong); font: 500 13px/1.2 var(--sans); }
  .model-row { display: flex; gap: 8px; }
  .model-row > :is(select, input) { flex: 1; min-width: 0; }
  /* 去掉系统下拉样式：系统箭头粗黑、贴边，还会多出几像素左内边距，和上面的输入框对不齐；
   * 箭头改成两道渐变拼出的小三角，颜色和「显示」按钮一样用 --muted */
  .field select {
    appearance: none;
    min-height: 38px;
    padding: 8px 36px 8px 12px;
    border: 1px solid var(--line-hi);
    border-radius: 12px;
    background:
      linear-gradient(45deg, transparent 50%, var(--muted) 50%) calc(100% - 20px) 50% / 5px 5px no-repeat,
      linear-gradient(135deg, var(--muted) 50%, transparent 50%) calc(100% - 15px) 50% / 5px 5px no-repeat,
      rgba(var(--ink-rgb), 0.03);
    color: var(--strong);
    font: 400 14px/1.4 var(--mono);
    cursor: var(--cursor-pointer);
    transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .field select:hover:not(:disabled) { border-color: color-mix(in srgb, var(--strong) 24%, transparent); }
  .field select:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-glow); }
  .field select:disabled { color: var(--muted); cursor: default; }
  .hint { min-height: 1.2em; margin: 0; color: var(--muted); font-size: 12px; }
  .test-result { margin: 0; color: var(--brand-ink); font-size: 13px; }
  .test-result.bad { color: var(--danger); }
  .refresh {
    min-height: 38px;
    padding: 0 14px;
    border-radius: 12px;
    font: 500 13px/1 var(--sans);
    cursor: var(--cursor-pointer);
    transition: background 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .refresh:active { transform: scale(0.97); }
  .refresh:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .refresh:disabled, footer button:disabled { opacity: 0.55; cursor: default; }
  .field input {
    width: 100%;
    min-height: 38px;
    padding: 8px 12px;
    border: 1px solid var(--line-hi);
    border-radius: 12px;
    background: rgba(var(--ink-rgb), 0.03);
    color: var(--strong);
    font: 400 14px/1.4 var(--mono);
    transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .field input:hover { border-color: color-mix(in srgb, var(--strong) 24%, transparent); }
  .field input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-glow); }
  .key { position: relative; display: block; }
  .key input { padding-right: 64px; }
  .reveal {
    position: absolute;
    top: 50%;
    right: 6px;
    padding: 4px 10px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: 500 12px/1 var(--sans);
    cursor: var(--cursor-pointer);
    transform: translateY(-50%);
  }
  .reveal:hover { color: var(--strong); background: rgba(var(--ink-rgb), 0.06); }
  .remember { display: flex; gap: 10px; align-items: flex-start; color: var(--strong); font-size: 13px; cursor: var(--cursor-pointer); }
  .remember input { margin-top: 3px; accent-color: var(--brand); }
  .remember small { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; }
  .error { margin: 0; color: var(--danger); font-size: 13px; }
  footer { display: flex; gap: 8px; align-items: center; margin-top: 4px; }
  .spacer { flex: 1; }
  footer button {
    min-height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    font: 500 13px/1 var(--sans);
    cursor: var(--cursor-pointer);
    transition: background 0.18s var(--ease), border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  footer button:active { transform: scale(0.97); }
  footer button:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .ghost { border: 1px solid var(--line-hi); background: transparent; color: var(--strong); }
  .ghost:hover { background: rgba(var(--ink-rgb), 0.05); }
  .clear { color: var(--danger); }
  .primary { border: 1px solid transparent; background: var(--brand); color: #001414; font-weight: 600; }
  .primary:hover { background: color-mix(in srgb, var(--brand) 88%, white); }
</style>
