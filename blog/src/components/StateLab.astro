---
/**
 * 状态实验台：iframe 里打开 AI 写的「文件」页（blog/public/lab/ai-states/files1-3.html，原样），
 * 在页面脚本之前注入一个假接口和 net-snippet.js（无面板模式），读者切换「接口怎么回」，再在页面里点删除、上传。
 * 页面里的 setTimeout / setInterval / AbortSignal.timeout 按 5 倍加速：15 秒的超时 3 秒就到。下方读数换算回页面时间。
 */
import '../styles/spacing-lab.css'
const base = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}lab/ai-states/`
---

<state-lab class="stl sx-panel sx-bleed not-prose" data-base={base}>
  <div class="stl-ctrl">
    <div class="sx-seg" role="group" aria-label="第几份">
      {[1, 2, 3].map((n) => <button type="button" data-page={n} aria-pressed={n === 2 ? 'true' : 'false'}>第 {n} 份</button>)}
    </div>
    <div class="sx-seg" role="group" aria-label="接口怎么回">
      {[['normal', '正常'], ['hang', '一直不回来'], ['error', '返回 500'], ['offline', '断网']].map(([k, v]) => <button type="button" data-mode={k} aria-pressed={k === 'hang' ? 'true' : 'false'}>{v}</button>)}
    </div>
    <button type="button" class="stl-reload">重新打开页面</button>
  </div>
  <div class="stl-body">
    <div class="stl-phone"><iframe title="AI 写的「文件」页，接口由这里模拟"></iframe></div>
    <div class="stl-side">
      <p class="stl-read" aria-live="polite">—</p>
      <p class="sx-cap">先用「一直不回来」打开页面：列表在加载。第 1、3 份等到第 15 秒会报错、给出「重试」，第 2 份一直转下去。再切到「正常」点「重新打开页面」，等列表出来后切回「一直不回来」，在页面里点「删除」或「上传文件」。页面里的时间按 5 倍加速，读数已换算回页面时间。</p>
    </div>
  </div>
</state-lab>

<script>
  const K = 5
  // 在页面脚本之前运行：时间加速、假接口（文件列表、删除、上传），并让 net-snippet 不画面板
  const prelude = () => `<script>(() => {
    const K = ${K}
    const st = setTimeout.bind(window), si = setInterval.bind(window)
    window.setTimeout = (fn, ms = 0, ...a) => st(fn, ms / K, ...a)
    window.setInterval = (fn, ms = 0, ...a) => si(fn, ms / K, ...a)
    if (AbortSignal.timeout) { const t = AbortSignal.timeout.bind(AbortSignal); AbortSignal.timeout = (ms) => t(ms / K) }
    let files = [
      { id: 1, name: '2026Q3 报告.pdf', size: '2.4 MB', updatedAt: '10月28日' },
      { id: 2, name: '团队周会纪要.docx', size: '86 KB', updatedAt: '10月27日' },
      { id: 3, name: '产品路线图.key', size: '18.2 MB', updatedAt: '10月25日' },
      { id: 4, name: '设计稿-v3.fig', size: '42.7 MB', updatedAt: '10月22日' },
    ]
    let next = 100
    const json = (b, s = 200) => new Response(JSON.stringify(b), { status: s, headers: { 'content-type': 'application/json' } })
    window.fetch = async (input, init = {}) => {
      const url = String(input instanceof Request ? input.url : input)
      const m = (init.method || (input instanceof Request ? input.method : 'GET')).toUpperCase()
      await new Promise((r) => st(r, 150))
      if (/files\\.json/.test(url)) return json(files)
      const d = url.match(/files\\/(\\d+)/)
      if (d && m === 'DELETE') { files = files.filter((f) => String(f.id) !== d[1]); return json({ ok: true }) }
      if (/upload/.test(url)) { const f = { id: next++, name: '新上传的文件.pdf', size: '1.1 MB', updatedAt: '刚刚' }; files.unshift(f); return json(f) }
      return json({ error: 'not found' }, 404)
    }
    window.__netLabHeadless = true
  })()<\/script>`
  const after = (mode: string) => `<script>window.__netLab && window.__netLab.set(${JSON.stringify(mode)})<\/script>`

  class StateLab extends HTMLElement {
    private state = { page: '2', mode: 'hang' }
    private cache = new Map<string, string>()
    private timer = 0

    connectedCallback() {
      this.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button')
        if (!b) return
        if (b.dataset.page) { this.state.page = b.dataset.page; this.load() }
        if (b.dataset.mode) { this.state.mode = b.dataset.mode; this.frameLab()?.set(this.state.mode) }
        if (b.classList.contains('stl-reload')) this.load()
        this.sync()
      })
      // 进入视口才加载，免得一打开文章就开始计时
      const io = new IntersectionObserver((es) => { if (es.some((x) => x.isIntersecting)) { io.disconnect(); this.load() } })
      io.observe(this)
      this.timer = window.setInterval(() => this.read(), 250)
      this.sync()
    }

    disconnectedCallback() { clearInterval(this.timer) }

    private frameLab() {
      return (this.querySelector('iframe')!.contentWindow as (Window & { __netLab?: { set(m: string): void; state(): { pending: { method: string; url: string; waited: number }[] } } }) | null)?.__netLab
    }

    private sync() {
      this.querySelectorAll<HTMLButtonElement>('[data-page]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.page === this.state.page)))
      this.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === this.state.mode)))
    }

    private async text(name: string) {
      if (!this.cache.has(name)) this.cache.set(name, await fetch(this.dataset.base + name).then((r) => r.text()))
      return this.cache.get(name)!
    }

    private async load() {
      const [page, snippet] = await Promise.all([this.text(`files${this.state.page}.html`), this.text('net-snippet.js')])
      const head = prelude() + `<script>${snippet.replace(/<\/script/gi, '<\\/script')}<\/script>` + after(this.state.mode)
      this.querySelector('iframe')!.srcdoc = page.replace(/<head>/i, `<head>${head}`)
    }

    private read() {
      const lab = this.frameLab()
      const out = this.querySelector('.stl-read')!
      if (!lab) return
      const p = lab.state().pending
      out.textContent = p.length
        ? p.map((r) => `${r.method === 'GET' ? '加载列表' : r.method === 'DELETE' ? '删除' : '上传'}的请求已等 ${Math.floor(r.waited * K)} 秒`).join('；')
        : '没有等待中的请求'
    }
  }
  if (!customElements.get('state-lab')) customElements.define('state-lab', StateLab)
</script>

<style is:global>
  .stl-ctrl { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
  .stl-reload { min-height: 38px; padding: 0 14px; border: 1px solid var(--line-hi); border-radius: 10px; background: var(--panel); color: var(--strong); font: 500 13px/1 var(--sans); cursor: var(--cursor-pointer); -webkit-tap-highlight-color: transparent; }
  @media (hover: hover) { .stl-reload:hover { border-color: var(--brand); } }
  .stl-reload:active { background: var(--panel-hi); }
  .stl-reload:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .stl-body { display: grid; grid-template-columns: 375px 1fr; gap: 24px; align-items: start; }
  .stl-phone { height: 600px; overflow: hidden; border: 1px solid var(--line-hi); border-radius: 18px; background: #fff; }
  .stl-phone iframe { display: block; width: 100%; height: 100%; border: 0; }
  .stl-read { margin: 0; padding: 12px 14px; border-radius: 10px; background: var(--panel); color: var(--strong); font: 500 14px/1.6 var(--sans); font-variant-numeric: tabular-nums; }
  @media (max-width: 860px) {
    .stl-body { grid-template-columns: 1fr; }
    .stl-phone { max-width: 375px; height: 560px; }
  }
</style>
